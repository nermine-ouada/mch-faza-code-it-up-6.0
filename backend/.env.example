# Copy to ".env" in this folder (backend/) before running.
# This file is Docker Compose friendly by default.
# - Inside Docker backend container, DB host is `sandy-db:5432`
# - If you run backend directly on host, use localhost:5433 instead.

# Postgres (async driver)
DATABASE_URL=postgresql+asyncpg://sandy:sandy123@sandy-db:5432/sandy_lab
# Host-run alternative:
# DATABASE_URL=postgresql+asyncpg://sandy:sandy123@localhost:5433/sandy_lab

# OpenRouter (required for live LLM routes)
OPENROUTER_API_KEY=
# Example models: openrouter/free (auto free-router), openrouter:meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free
# Optional automatic fallback order for rate limits (comma-separated).
# OPENROUTER_FALLBACK_MODELS=openrouter:meta-llama/llama-3.3-70b-instruct:free,openrouter:qwen/qwen3-32b:free

# Optional: live web search for research-agent
TAVILY_API_KEY=

# Auth
JWT_SECRET=change-me-in-production
# Set false in production to disable POST /api/auth/register
ALLOW_OPEN_REGISTRATION=true
# false = require JWT on protected routes (default). true = dev-only open API.
SKIP_AUTH=false

# Optional: POST JSON usage events (e.g. chat_stream) to a collector — see services/usage-reporter/README.md
# USAGE_WEBHOOK_URL=http://127.0.0.1:8099/ingest
# CORS for frontend access from host browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Optional regex for local dev origins (default allows localhost/127.0.0.1 any port)
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
