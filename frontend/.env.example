# Optional: absolute API base (leave empty to use Vite dev proxy `/api` → http://127.0.0.1:8000)
# VITE_API_BASE=http://127.0.0.1:8000

# When "true", Lab Assistant calls POST /api/chat/stream (needs OPENROUTER_API_KEY on backend).
VITE_LIVE_AGENT=false

# Optional architecture switch for Assistant:
# - "deepagent": uses /api/agent/chat + /api/agent/approve (human approval flow)
# - unset: uses existing Assistant mode (stream/demo)
# VITE_AGENT_ARCH=deepagent

# Rare: skip login in the UI (requires SKIP_AUTH=true on API). Default is normal JWT login.
# VITE_SKIP_AUTH=true
