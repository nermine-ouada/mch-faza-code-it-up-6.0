# Docker Compose / host browser default:
# Frontend runs on localhost:5173 and backend is exposed on localhost:8000.
VITE_API_BASE=http://localhost:8000

# Assistant mode (recommended for this project flow)
VITE_LIVE_AGENT=false

# Use native deepagent endpoints with approval flow.
VITE_AGENT_ARCH=deepagent

# Rare: skip login in the UI (requires SKIP_AUTH=true on API). Default is normal JWT login.
# VITE_SKIP_AUTH=true
